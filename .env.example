# Sole World environment template.
#
# Copy to .env and edit. Docker Compose reads .env automatically, and .env is gitignored, so real
# keys never reach the repository.
#
#   cp .env.example .env
#
# Every value below is optional except API_KEYS: Compose refuses to start without it, so a
# deployment cannot accidentally come up unauthenticated.

# --- Image and ports ---------------------------------------------------------------------------

# Published image, or a tag you built locally (see "Build a Docker Image Locally" in the README).
# Pin a version tag in production instead of :latest.
API_IMAGE=ghcr.io/voirdev/sole-world-api:latest

# Host port mapped to the container's 8080.
API_PORT=18080

# --- Authentication ----------------------------------------------------------------------------

# Accepted API keys, separated by commas or whitespace. Each must be at least 16 characters or the
# application refuses to start. Issue one key per consumer so a single key can be revoked alone.
#
# Generate one with:
#   openssl rand -hex 32
API_KEYS=replace-me-with-a-generated-key

# Set to false to serve the API with no authentication at all. The application logs a warning at
# startup when it does. Only do this for a deliberately public deployment.
API_AUTH_ENABLED=true

# --- Developer consoles ------------------------------------------------------------------------

# The OpenAPI contract at /openapi.yaml and its reference page at /docs.
# When false, neither route exists and neither is reachable without a key.
API_DOCS_ENABLED=true

# The GraphiQL console at /graphiql. When false, the route does not exist.
# Both consoles are served entirely from the image and need no outbound internet access.
GRAPHIQL_ENABLED=true

# --- Browser access ----------------------------------------------------------------------------

# Comma-separated allowed origins. Use your real frontend origins in production instead of "*".
CORS_ALLOWED_ORIGINS=*

# --- Assets ------------------------------------------------------------------------------------

# Origin that image paths are published under. Leave empty to publish them rooted at this deployment
# (/assets/flags/us_1x1.svg). Set it to a CDN origin to publish absolute URLs pointing there.
ASSET_BASE_URL=

# --- Limits and resources ----------------------------------------------------------------------

# Container memory limit. The dataset is held in memory, and the limit covers the heap plus
# metaspace, the code cache and worker-thread stacks; see "Resources" in the README.
API_MEMORY_LIMIT=768M

# Worker threads. Every request reads an in-memory index, so a worker is busy for about a
# millisecond and a large pool buys nothing but thread stacks.
SERVER_THREADS_MAX=64

# Container CPU limit, and the maximum number of processes it may hold. The service runs one JVM and
# never forks, so the process cap is generous already.
API_CPU_LIMIT=2
API_PIDS_LIMIT=256

# Guards against pathological GraphQL documents. Cost is weighted by how much data a field may
# scan, declared in the schema with @cost, so aliasing an expensive listing is not free.
GRAPHQL_MAX_QUERY_DEPTH=30
GRAPHQL_MAX_QUERY_COMPLEXITY=1000

# Per-key request allowance on /v1/** and /graphql, counted per replica. Callers past it get a 429
# with Retry-After. GET /v1/meta reports the allowance so clients can pace themselves.
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=600
API_RATE_LIMIT_BURST=120

# --- Logging -----------------------------------------------------------------------------------

# One of TRACE, DEBUG, INFO, WARN, ERROR.
LOG_LEVEL=INFO
