Paginated languages result.
"""
type LanguagePage {
    """
    Languages on the requested page.
    """
    items: [Language!]!

    """
    Pagination metadata.
    """
    pageInfo: PageInfo!
}

"""
Paginated locales result.
"""
type LocalePage {
    """
