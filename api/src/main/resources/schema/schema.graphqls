    Pagination metadata.
    """
    pageInfo: PageInfo!
}

"""
Paginated regions result.
"""
type RegionPage {
    """
    Regions on the requested page.
    """
    items: [Region!]!

    """
    Pagination metadata.
    """
    pageInfo: PageInfo!
}

"""
Paginated subregions result.
"""
type SubregionPage {
    """
    Subregions on the requested page.
    """
    items: [Subregion!]!

    """
    Pagination metadata.
    """
    pageInfo: PageInfo!
}

"""
Paginated timezones result.
"""
type TimezonePage {
    """
    Timezones on the requested page.
    """
    items: [Timezone!]!

    """
    Pagination metadata.
    """
    pageInfo: PageInfo!
}

"""
Paginated central banks result.
"""
type CentralBankPage {
    """
    Central banks on the requested page.
    """
    items: [CentralBank!]!

    """
    Pagination metadata.
    """
    pageInfo: PageInfo!
}

"""
Paginated states or provinces result.
"""
type StatePage {
    """
    States or provinces on the requested page.
    """
    items: [State!]!

    """
    Pagination metadata.
    """
    pageInfo: PageInfo!
}

"""
Paginated cities result.
"""
type CityPage {
    """
    Cities on the requested page.
    """
    items: [City!]!

    """
    Pagination metadata.
    """
    pageInfo: PageInfo!
}

"""
Paginated media assets result.
"""
type MediaAssetPage {
    """
    Media assets on the requested page.
    """
    items: [MediaAsset!]!

    """
    Pagination metadata.
    """
    pageInfo: PageInfo!
}

"""
Kinds of media assets served by this API.
"""
enum MediaAssetType {
    """
    Raster or vector image asset.
    """
    Image
}

"""
Supported image aspect-ratio families.
"""
enum ImageAssetAspectRatio {
    """
    Square image family.
    """
    Square

    """
    Wide image family.
    """
    Wide
}

"""
Read-only GraphQL queries for world reference data.

Every capability a resource has is reachable from both transports. Each resource offers a list field
carrying the same filters and search as its REST collection, and a single-item field taking the same
identifier the REST path segment takes. Loading a batch by ids is GraphQL-only, and embedding
relationships with `include` is REST-only: each is that transport's answer to the same round-trip
problem, and neither has anything to say on the other.
"""
type Query {
    """
    Lists or searches countries. Filters combine with AND.
    """
    countries(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput

        """
        Optional relevance search. Ranks the same way the REST endpoint does.
        """
        query: String

        """
        Only countries in this region.
        """
        regionId: ID

        """
        Only countries in this subregion.
        """
        subregionId: ID

        """
        Only countries that use this currency.
        """
        currencyId: ID

        """
        Only countries that use this language.
        """
        languageId: ID

        """
        Only countries in this timezone.
        """
        timezoneId: ID
    ): CountryPage!

    """
    Loads one country by identifier, the same identifiers the REST path accepts.
    """
    country(
        """
        ISO 3166-1 alpha-2 code. The alpha-3 and numeric codes resolve too, in any case.
        """
        id: ID!
    ): Country

    """
    Loads countries by id. Accepts at most 50 ids.
    """
    countriesByIds(
        """
        Country ids to load.
        """
        ids: [ID!]!
    ): [Country!]!

    """
    Lists or searches currencies, ordered by popularity unless `sort` says otherwise.
    """
    currencies(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput

        """
        Optional relevance search. Ranks the same way the REST endpoint does.
        """
        query: String

        """
        Restrict to obsolete or active currencies. Omit to return both.
        """
        obsolete: Boolean

        """
        Field to order by. Defaults to POPULARITY, or to relevance when `query` is supplied; an
        explicit sort overrides relevance.
        """
        sort: CurrencySort

        """
        Direction. Defaults to the direction the chosen field is useful in: DESC for POPULARITY,
        ASC for NAME, CODE and YEAR.
        """
        order: SortOrder
    ): CurrencyPage!

    """
    Loads one currency by identifier, the same identifiers the REST path accepts.
    """
    currency(
        """
        ISO 4217 alpha code. The ISO 4217 numeric code resolves too, in any case.
        """
        id: ID!

        """
        Allow an obsolete currency to be returned. Defaults to false.
        """
        withObsolete: Boolean
    ): Currency

    """
    Loads currencies by id. Accepts at most 50 ids.
    """
    currenciesByIds(
        """
        Currency ids to load.
        """
        ids: [ID!]!
    ): [Currency!]!

    """
    Lists or searches cryptocurrencies.
    """
    cryptos(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput

        """
        Optional relevance search. Ranks the same way the REST endpoint does.
        """
        query: String

        """
        Restrict to obsolete or active coins. Omit to return both.
        """
        obsolete: Boolean
    ): CryptoPage!

    """
    Loads one cryptocurrency by identifier, the same identifiers the REST path accepts.
    """
    crypto(
        """
        The coin's alias. Its ticker symbol resolves too, in any case.
        """
        id: ID!
    ): Crypto

    """
    Loads cryptocurrencies by id. Accepts at most 50 ids.
    """
    cryptosByIds(
        """
        Cryptocurrency ids to load.
        """
        ids: [ID!]!
    ): [Crypto!]!

    """
    Lists or searches languages.
    """
    languages(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput

        """
        Optional relevance search. Ranks the same way the REST endpoint does.
        """
        query: String
    ): LanguagePage!

    """
    Loads one language by identifier, the same identifiers the REST path accepts.
    """
    language(
        """
        ISO 639-1 language code, in any case.
        """
        id: ID!
    ): Language

    """
    Loads languages by id. Accepts at most 50 ids.
    """
    languagesByIds(
        """
        Language ids to load.
        """
        ids: [ID!]!
    ): [Language!]!

    """
    Lists or searches the translation locales `Accept-Language` can select.
    """
    locales(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput

        """
        Optional relevance search. Ranks the same way the REST endpoint does.
        """
        query: String
    ): LocalePage!

    """
    Loads one translation locale by identifier, the same identifiers the REST path accepts.
    """
    locale(
        """
        BCP 47 language tag, in any case.
        """
        id: ID!
    ): Locale

    """
    Loads translation locales by id. Accepts at most 50 ids.
    """
    localesByIds(
        """
        Locale ids to load.
        """
        ids: [ID!]!
    ): [Locale!]!

    """
    Lists or searches regions.
    """
    regions(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput

        """
        Optional relevance search. Ranks the same way the REST endpoint does.
        """
        query: String
    ): RegionPage!

    """
    Loads one region by id.
    """
    region(
        """
        Region id to load.
        """
        id: ID!
    ): Region

    """
    Loads regions by id. Accepts at most 50 ids.
    """
    regionsByIds(
        """
        Region ids to load.
        """
        ids: [ID!]!
    ): [Region!]!

    """
    Lists or searches subregions.
    """
    subregions(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput

        """
        Optional relevance search. Ranks the same way the REST endpoint does.
        """
        query: String

        """
        Only subregions inside this region.
        """
        regionId: ID
    ): SubregionPage!

    """
    Loads one subregion by id.
    """
    subregion(
        """
        Subregion id to load.
        """
        id: ID!
    ): Subregion

    """
    Loads subregions by id. Accepts at most 50 ids.
    """
    subregionsByIds(
        """
        Subregion ids to load.
        """
        ids: [ID!]!
    ): [Subregion!]!

    """
    Lists or searches central banks.
    """
    centralBanks(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput

        """
        Optional relevance search. Ranks the same way the REST endpoint does.
        """
        query: String
    ): CentralBankPage!

    """
    Loads one central bank by id.
    """
    centralBank(
        """
        Central bank id to load.
        """
        id: ID!
    ): CentralBank

    """
    Loads central banks by id. Accepts at most 50 ids.
    """
    centralBanksByIds(
        """
        Central bank ids to load.
        """
        ids: [ID!]!
    ): [CentralBank!]!

    """
    Lists or searches states and provinces.
    """
    states(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput

        """
        Optional relevance search. Ranks the same way the REST endpoint does.
        """
        query: String

        """
        Only states in this country.
        """
        countryId: ID
    ): StatePage! @cost(weight: 6)

    """
    Loads one state or province by id.
    """
    state(
        """
        State or province id to load.
        """
        id: ID!
    ): State

    """
    Loads states or provinces by id. Accepts at most 50 ids.
    """
    statesByIds(
        """
        State or province ids to load.
        """
        ids: [ID!]!
    ): [State!]!

    """
    Lists or searches cities. Filters combine with AND.
    """
    cities(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput

        """
        Optional relevance search. Ranks the same way the REST endpoint does.
        """
        query: String

        """
        Only cities in this country.
        """
        countryId: ID

        """
        Only cities in this state.
        """
        stateId: ID
    ): CityPage! @cost(weight: 150)

    """
    Loads one city by id.
    """
    city(
        """
        City id to load.
        """
        id: ID!
    ): City

    """
    Loads cities by id. Accepts at most 50 ids.
    """
    citiesByIds(
        """
        City ids to load.
        """
        ids: [ID!]!
    ): [City!]!

    """
    Lists or searches timezones.
    """
    timezones(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput

        """
        Optional relevance search. Ranks the same way the REST endpoint does.
        """
        query: String
    ): TimezonePage!

    """
    Loads one timezone by id.
    """
    timezone(
        """
        Timezone id to load.
        """
        id: ID!
    ): Timezone

    """
    Loads timezones by id. Accepts at most 50 ids.
    """
    timezonesByIds(
        """
        Timezone ids to load.
        """
        ids: [ID!]!
    ): [Timezone!]!

    """
    Lists or searches flags. `query` ranks over captions and emoji.
    """
    flags(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput

        """
        Optional relevance search. Ranks the same way the REST endpoint does.
        """
        query: String
    ): FlagPage!

    """
    Loads one flag by id.
    """
    flag(
        """
        Flag id to load.
        """
        id: ID!
    ): Flag

    """
    Loads flags by id. Accepts at most 50 ids.
    """
    flagsByIds(
        """
        Flag ids to load.
        """
        ids: [ID!]!
    ): [Flag!]!

    """
    Lists media assets.
    """
    mediaAssets(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput
    ): MediaAssetPage!

    """
    Loads one media asset by id.
    """
    mediaAsset(
        """
        Media asset id to load.
        """
        id: ID!
    ): MediaAsset

    """
    Loads media assets by id. Accepts at most 50 ids.
    """
    mediaAssetsByIds(
        """
        Media asset ids to load.
        """
        ids: [ID!]!
    ): [MediaAsset!]!
}
