"""
Relative cost of resolving a field, used by this deployment's query-complexity limit.

The weight is the size of the record set the field may have to scan, in thousands, rounded up and
never below one. A document's complexity is the sum of every selected field's weight, so the limit
counts work rather than syntax: twenty aliased city listings cost twenty city scans, which is what
they actually are, while a deeply nested query over small entities stays cheap.

`GET /v1/meta` reports the limit this deployment enforces.
"""
directive @cost(
    """
    Records the field may scan, in thousands, rounded up. Defaults to 1 for fields that resolve
    from an identifier or an already-narrowed collection.
    """
    weight: Int! = 1
) on FIELD_DEFINITION

"""
Calendar date without a time or timezone.
"""
scalar LocalDate

"""
Geographic coordinates in decimal degrees.
"""
type Coordinates {
    """
    Latitude in decimal degrees.
    """
    latitude: Float!

    """
    Longitude in decimal degrees.
    """
    longitude: Float!
}

"""
Zero-based pagination request. When omitted, the API uses page 0 and size 50.
"""
input PageInput {
    """
    Zero-based page number. Defaults to 0.
    """
    page: Int

    """
    Number of records to return. Defaults to 50 and cannot exceed 50.
    """
    size: Int
}

"""
Pagination metadata returned with every paginated list.
"""
type PageInfo {
    """
    Zero-based page number returned by this response.
    """
    page: Int!

    """
    Number of records requested for this page.
    """
    size: Int!

    """
    Total number of matching records across all pages.
    """
    totalItems: Int!

    """
    Total number of available pages.
    """
    totalPages: Int!

    """
    Whether another page exists after this page.
    """
    hasNextPage: Boolean!

    """
    Whether a page exists before this page.
    """
    hasPreviousPage: Boolean!
}

"""
A central bank that serves one or more countries and can issue one or more currencies.
"""
type CentralBank {
    """
    Central bank alias, such as `federal-reserve`.
    """
    id: ID!

    """
    Display name in the requested language when a translation is available.
    """
    name: String!

    """
    Native-language name when available.
    """
    nativeName: String

    """
    Official website URL when available.
    """
    websiteUrl: String

    """
    Establishment year when known.
    """
    establishmentYear: Int

    """
    Countries this central bank serves.
    """
    countries: [Country!]

    """
    Currencies this central bank issues.
    """
    currencies: [Currency!]
}

"""
A populated place inside a state or province.
"""
type City {
    """
    Numeric city identifier. Cities have no public code, so they keep their numbers.
    """
    id: ID!

    """
    Display name in the requested language when a translation is available.
    """
    name: String!

    """
    City coordinates.
    """
    coordinates: Coordinates!

    """
    Parent state or province identifier.
    """
    stateId: ID!

    """
    Parent state or province.
    """
    state: State

    """
    Country the parent state belongs to.
    """
    country: Country
}

"""
A static media asset served by this API.
"""
type MediaAsset {
    """
    Media asset alias: owner kind, key and shape, such as `flag-us-square`.
    """
    id: ID!

    """
    Asset kind.
    """
    type: MediaAssetType!

    """
    Stable machine key for the asset, and the name its files are stored under — `zw` for Zimbabwe's
    flag, `btc` for Bitcoin's logo. Match on this when a client needs to recognise an asset; it is
    unique per aspect ratio, so a flag's square and wide images share one.
    """
    key: String!

    """
    Prose naming what the asset shows, for people rather than for matching.
    """
    description: String!

    """
    Image metadata when this media asset is an image.
    """
    image: ImageAsset
}

"""
Image-specific metadata for a media asset.
"""
type ImageAsset {
    """
    Image aspect-ratio family.
    """
    aspectRatio: ImageAssetAspectRatio!

    """
    Available file formats and sizes.
    """
    formats: ImageAssetFormats!
}

"""
Available file formats for an image asset.

Every path is published rooted at this deployment — `/assets/flags/us_1x1.svg` — or, when the
deployment fronts its assets with a CDN, as an absolute URL against that origin. Either way it can
be used as-is.
"""
type ImageAssetFormats {
    """
    SVG path when available.
    """
    svg: String

    """
    PNG paths by size when available.
    """
    png: ImageAssetSizes

    """
    WebP paths by size when available.
    """
    webp: ImageAssetSizes

    """
    JPG paths by size when available.
    """
    jpg: ImageAssetSizes
}

"""
Available image paths for a bitmap format.
"""
type ImageAssetSizes {
    """
    Extra-small image path.
    """
    xs: String

    """
    Small image path.
    """
    sm: String

    """
    Medium image path.
    """
    md: String

    """
    Large image path.
    """
    lg: String

    """
    Extra-large image path.
    """
    xl: String
}

"""
A reusable flag record with optional square and wide media assets.
"""
type Flag {
    """
    Flag alias. A territory's flag is its lowercase ISO 3166-1 alpha-2 code, such as `us`.
    """
    id: ID!

    """
    Human-readable flag caption.
    """
    caption: String!

    """
    Unicode emoji for the flag.
    """
    emoji: String!

    """
    Unicode code points for the flag emoji.
    """
    emojiU: String!

    """
    Identifier of the square media asset when available.
    """
    squareAssetId: ID

    """
    Identifier of the wide media asset when available.
    """
    wideAssetId: ID

    """
    Square media asset when available.
    """
    squareAsset: MediaAsset

    """
    Wide media asset when available.
    """
    wideAsset: MediaAsset
}

"""
A country or country-like territory in the dataset.
"""
type Country {
    """
    ISO 3166-1 alpha-2 code, such as `US`.
    """
    id: ID!

    """
    Display name in the requested language when a translation is available.
    """
    name: String!

    """
    Native-language country name when available.
    """
    nativeName: String

    """
    ISO 3166-1 alpha-3 code.
    """
    iso3: String!

    """
    ISO 3166-1 alpha-2 code.
    """
    iso2: String!

    """
    ISO 3166-1 numeric code as a string to preserve leading zeros.
    """
    isoNumeric: String!

    """
    International calling code.
    """
    phoneCode: String!

    """
    Country top-level domain when available.
    """
    tld: String

    """
    Approximate country coordinates.
    """
    coordinates: Coordinates!

    """
    Parent region identifier.
    """
    regionId: ID!

    """
    Parent subregion identifier.
    """
    subregionId: ID!

    """
    Flag identifier when available.
    """
    flagId: ID

    """
    Flag record when available.
    """
    flag: Flag

    """
    Parent region.
    """
    region: Region

    """
    Parent subregion.
    """
    subregion: Subregion

    """
    Currencies used by the country.
    """
    currencies: [Currency!]

    """
    Timezones associated with the country.
    """
    timezones: [Timezone!]

    """
    Languages associated with the country.
    """
    languages: [Language!]

    """
    Central banks serving the country.
    """
    centralBanks: [CentralBank!]

    """
    First-level administrative divisions.
    """
    states(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput

        """
        Optional case-insensitive state or province name filter.
        """
        query: String
    ): StatePage! @cost(weight: 3)

    """
    Cities grouped under the country's states.
    """
    cities(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput

        """
        Optional case-insensitive city name filter.
        """
        query: String
    ): CityPage! @cost(weight: 20)
}

"""
Field a currency listing is ordered by.
"""
enum CurrencySort {
    """
    Most widely used first.
    """
    POPULARITY

    """
    Display name in the requested language, collated for that language.
    """
    NAME

    """
    ISO 4217 alpha code.
    """
    CODE

    """
    Introduction year. Currencies with no known year come last in either direction.
    """
    YEAR
}

"""
Direction a sorted listing runs in.
"""
enum SortOrder {
    ASC
    DESC
}

"""
A currency, including active and obsolete records.
"""
type Currency {
    """
    ISO 4217 alpha code, such as `EUR`.
    """
    id: ID!

    """
    ISO 4217 alpha code.
    """
    iso3: String!

    """
    ISO 4217 numeric code as a string to preserve leading zeros.
    """
    isoNumeric: String!

    """
    Display name in the requested language when a translation is available.
    """
    name: String!

    """
    Number of decimal digits commonly used by the currency.
    """
    decimalDigits: Int!

    """
    How widely the currency is used today, from 0 to 100. The scale blends foreign-exchange
    turnover, payment share and reserve status at the top with the size of the issuing economy and
    the number of countries using it further down. Obsolete currencies score 0.
    """
    popularity: Int!

    """
    Currency description when available.
    """
    description: String

    """
    Native-language currency name when available.
    """
    nativeName: String

    """
    Currency symbol when available.
    """
    symbol: String

    """
    Introduction year when known.
    """
    year: Int

    """
    Introduction date when known.
    """
    introducedDate: LocalDate

    """
    Whether the currency is obsolete.
    """
    obsolete: Boolean!

    """
    Obsolescence date when known.
    """
    obsoleteAt: LocalDate

    """
    Replacement currency identifier when available.
    """
    replacedById: ID

    """
    Replacement currency when this one is obsolete and a successor is known.
    """
    replacedBy: Currency

    """
    Flag identifier when available.
    """
    flagId: ID

    """
    Flag record when available.
    """
    flag: Flag

    """
    Central banks that issue this currency.
    """
    centralBanks: [CentralBank!]

    """
    Countries that use this currency.
    """
    countries: [Country!]
}

"""
A cryptocurrency.
"""
type Crypto {
    """
    The coin's alias: its stable lowercase key, such as `btc`. A ticker can be renamed; the
    alias is what stays the same, and it is the name the coin's logo files are stored under.
    """
    id: ID!

    """
    Ticker symbol the coin trades under.
    """
    code: String!

    """
    Display name.
    """
    name: String!

    """
    Description text when available.
    """
    description: String

    """
    Official project website when known.
    """
    websiteUrl: String

    """
    Year the coin launched when known.
    """
    introducedYear: Int

    """
    Number of decimal digits commonly used for minor units.
    """
    decimalDigits: Int!

    """
    Whether the coin is no longer active.
    """
    obsolete: Boolean!

    """
    Date the coin became obsolete when known.
    """
    obsoleteAt: LocalDate

    """
    Media asset identifier of the coin's logo when one is bundled.
    """
    logoId: ID

    """
    The coin's logo when one is bundled.
    """
    logo: MediaAsset
}

"""
A human language associated with one or more countries.
"""
type Language {
    """
    ISO 639-1 code, such as `fr`.
    """
    id: ID!

    """
    Language code.
    """
    code: String!

    """
    Native-language name when available.
    """
    nativeName: String

    """
    Display name in the requested language when a translation is available.
    """
    name: String!

    """
    Language description when available.
    """
    description: String

    """
    Flag identifier when available.
    """
    flagId: ID

    """
    Flag record when available.
    """
    flag: Flag

    """
    Countries associated with this language.
    """
    countries: [Country!]
}

"""
A translation locale: a language a response can be rendered in, selected with `Accept-Language`.
"""
type Locale {
    """
    BCP 47 language tag, such as `pt-BR`.
    """
    id: ID!

    """
    Identifier of the language this locale is a form of.
    """
    languageId: ID!

    """
    Language this locale is a form of.
    """
    language: Language

    """
    Display name in the requested language when a translation is available.
    """
    name: String!

    """
    Name written in the locale itself, as a language picker shows it.
    """
    nativeName: String!
}

"""
A high-level geographic region.
"""
type Region {
    """
    Region alias, such as `europe`.
    """
    id: ID!

    """
    Display name in the requested language when a translation is available.
    """
    name: String!

    """
    Subregions inside this region.
    """
    subregions: [Subregion!]

    """
    Countries inside this region.
    """
    countries: [Country!]
}

"""
A geographic subregion inside a region.
"""
type Subregion {
    """
    Subregion alias, such as `western-europe`.
    """
    id: ID!

    """
    Display name in the requested language when a translation is available.
    """
    name: String!

    """
    Parent region identifier.
    """
    regionId: ID!

    """
    Parent region.
    """
    region: Region

    """
    Countries inside this subregion.
    """
    countries: [Country!]
}

"""
A first-level administrative division such as a state, province, or territory.
"""
type State {
    """
    Country alpha-2 code and state code joined by a hyphen, such as `US-CA`. A state with no
    code has an alias of the same form made from its name, such as `AX-MARIEHAMN`.
    """
    id: ID!

    """
    Display name in the requested language when a translation is available.
    """
    name: String!

    """
    Administrative division code when available.
    """
    stateCode: String

    """
    Coordinates when available.
    """
    coordinates: Coordinates

    """
    Administrative division type when available.
    """
    type: String

    """
    Parent country identifier.
    """
    countryId: ID!

    """
    Parent country.
    """
    country: Country

    """
    Cities inside this state or province.
    """
    cities(
        """
        Optional pagination request. Defaults to page 0 and size 50.
        """
        page: PageInput

        """
        Optional case-insensitive city name filter.
        """
        query: String
    ): CityPage! @cost(weight: 3)
}

"""
A timezone record associated with one or more countries.
"""
type Timezone {
    """
    IANA timezone name, such as `Europe/Paris`.
    """
    id: ID!

    """
    IANA timezone name.
    """
    zoneName: String!

    """
    Display timezone name in the requested language when a translation is available.
    """
    tzName: String!

    """
    Offset from GMT in seconds.
    """
    gmtOffset: Int!

    """
    Human-readable GMT offset.
    """
    gmtOffsetName: String!

    """
    Timezone abbreviation.
    """
    abbreviation: String!
}

"""
Paginated countries result.
"""
type CountryPage {
    """
    Countries on the requested page.
    """
    items: [Country!]!

    """
    Pagination metadata.
    """
    pageInfo: PageInfo!
}

"""
Paginated currencies result.
"""
type CurrencyPage {
    """
    Currencies on the requested page.
    """
    items: [Currency!]!

    """
    Pagination metadata.
    """
    pageInfo: PageInfo!
}

"""
Paginated cryptocurrencies result.
"""
type CryptoPage {
    """
    Cryptocurrencies on the requested page.
    """
    items: [Crypto!]!

    """
    Pagination metadata.
    """
    pageInfo: PageInfo!
}

